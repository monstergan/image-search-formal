<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.imagesearchformal.mapper.ImgSearchInstanceMapper">

    <select id="selectEnabledInstance" resultType="com.example.imagesearchformal.domain.entity.ImgSearchInstance">
        select *
        from img_search_instance
        where provider = #{provider}
          and enabled = 1
        order by id asc
        limit 1
    </select>

</mapper>
